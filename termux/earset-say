#!/data/data/com.termux/files/usr/bin/python3
"""earset-say - Muse speaks through the Muse Earset app on this phone.

    earset-say "Text to speak"     (or pipe the text on stdin)

Hands the text to the app's spoken-answer listener (127.0.0.1:47824/say), which speaks it
in the voice the owner chose in the app (Google Cloud or built-in). Prints one JSON line:
{"ok": true} or {"ok": false, "why": "..."}. Loopback only.
"""

import json
import os
import sys
import urllib.request

PORT = 47824


def _host() -> str:
    # Where the earset app listens. Same phone by default; in a split setup the app
    # device's LAN address (e.g. a tablet) - from the EARSET_APP_HOST env var, or from
    # ~/.musegadget/earset_app_host (gadget child processes don't inherit shell env,
    # so the file is the reliable place on a gadget host).
    h = os.environ.get("EARSET_APP_HOST", "").strip()
    if h:
        return h
    try:
        with open(os.path.expanduser("~/.musegadget/earset_app_host")) as f:
            h = f.read().strip()
        if h:
            return h
    except OSError:
        pass
    return "127.0.0.1"


HOST = _host()


def main() -> int:
    text = " ".join(sys.argv[1:]).strip()
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read().strip()
    if not text:
        print(json.dumps({"ok": False, "why": "no text"}))
        return 2
    req = urllib.request.Request(
        f"http://{HOST}:{PORT}/say",
        data=json.dumps({"text": text}).encode(),
        headers={"Content-Type": "application/json; charset=utf-8"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            print(resp.read().decode())
            return 0
    except Exception as exc:  # app not running, service down, ...
        print(json.dumps({"ok": False, "why": f"earset app: {exc}"}))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
